// # oobindiff Main Entry Point - Sovereign Binary Differ
//
// Logline: Ingests dual binary streams, identifying mutations, diff hunks, and similarity metrics.
//
// Setup: Demands explicit capability tokens and standard argument list.
//
// Beats:
//   1. Parse command-line options and dispatch --help, --version, or --mcp.
//   2. Read dual comparison target files using capability-bounded file reader.
//   3. Compute byte mutation rows, contiguous hunks, and similarity score.

import "core/diff_types.oo";
import "core/bindiff_engine.oo";
import "render/bindiff_theme.oo";
import "ipc/json_field.oo";
import "ipc/bindiff_opts.oo";
import "ipc/mcp_serve.oo";

fn render_help() -> String {
    return "oobindiff 0.2.0 (openOODA sovereign binary comparison)\n"
        + "usage: oobindiff [options] <FILE_A> <FILE_B>\n\n"
        + "Capability-bounded binary file comparator and differential hunk analyzer.\n\n"
        + "Options:\n"
        + "  -h, --help               display this help and exit\n"
        + "  -v, --version            output version information and exit\n"
        + "  -s, --summary            display aggregate similarity and metrics only\n"
        + "  -u, --hunks              display contiguous mutated difference hunks\n"
        + "  -o, --offset <N>         start offset for detailed byte comparisons [default: 0]\n"
        + "  -n, --limit <N>          maximum difference rows to display [default: 100]\n"
        + "      --json               output telemetry as formatted JSON\n"
        + "      --mcp                run as Model Context Protocol stdio server\n";
}

pub fn main(
    fs: &FsReadCap,
    proc_cap: &ProcessCap,
    env: &EnvCap,
    args: List[String]
) -> Result[Int, String] {
    let opts: BindiffOpts = parse_bindiff_args(args);

    if opts.action == "help" {
        print(render_help());
        return Ok(0);
    }

    if opts.action == "version" {
        println("oobindiff 0.2.0 (openOODA sovereign binary comparison)");
        return Ok(0);
    }

    if opts.action == "mcp" {
        run_mcp_server(fs);
        return Ok(0);
    }

    if chars_len(opts.file_a) == 0 || chars_len(opts.file_b) == 0 {
        println("oobindiff: missing file operands\nTry 'oobindiff --help' for more information.");
        return Ok(1);
    }

    let fa: Result[String, String] = read_file(fs, opts.file_a);
    let fb: Result[String, String] = read_file(fs, opts.file_b);

    if !fa.is_ok() || !fb.is_ok() {
        println("oobindiff: cannot open comparison targets: No such file or read error");
        return Ok(1);
    }

    let ca: String = match fa { Ok(s) => s, Err(_) => "" };
    let cb: String = match fb { Ok(s) => s, Err(_) => "" };
    let rep: BindiffReport = analyze_bindiff(ca, cb);

    if opts.json_mode {
        let hunks: String = find_hunks_summary(ca, cb, 50);
        println(render_diff_json(rep, json_escape_string(hunks)));
        return Ok(0);
    }

    if opts.summary_only {
        print(render_report_summary(rep));
        return Ok(0);
    }

    if opts.hunks_mode {
        print(render_report_summary(rep));
        let hunks: String = find_hunks_summary(ca, cb, 50);
        if chars_len(hunks) > 0 {
            println(hunks);
        }
        return Ok(0);
    }

    print(render_report_summary(rep));
    let rows: String = format_diff_rows(ca, cb, opts.start_offset, opts.limit);
    if chars_len(rows) > 0 {
        println(rows);
    }

    return Ok(0);
}
