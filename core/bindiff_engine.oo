// # oobindiff Differential Comparison Engine
//
// Logline: Ingests dual binary streams, computing byte discrepancies, hunks, and similarity.
//
// Setup: Pure comparison algorithms traversing byte streams with capability-bounded limits.
//
// Beats:
//   1. Compare dual byte streams calculating matches, mismatches, and percentage metrics.
//   2. Identify and summarize contiguous difference hunks across offset spaces.
//   3. Render detailed byte mutation rows with hexadecimal values and ASCII characters.

import "core/diff_types.oo";
import "core/hex_format.oo";

pub fn analyze_bindiff(a: String, b: String) -> BindiffReport {
    let len_a: Int = chars_len(a);
    let len_b: Int = chars_len(b);
    let mut min_len: Int = len_a;
    let mut max_len: Int = len_b;
    if len_a > len_b {
        min_len = len_b;
        max_len = len_a;
    }

    if max_len == 0 {
        return BindiffReport {
            size_a: 0,
            size_b: 0,
            matching: 0,
            mismatches: 0,
            similarity_pct: 100
        };
    }

    let mut matches: Int = 0;
    let mut mismatches: Int = 0;
    let mut i: Int = 0;

    while i < min_len {
        let ba: Int = byte_at(a, i);
        let bb: Int = byte_at(b, i);
        if ba == bb {
            matches = matches + 1;
        } else {
            mismatches = mismatches + 1;
        }
        i = i + 1;
    }

    mismatches = mismatches + (max_len - min_len);
    let pct: Int = (matches * 100) / max_len;

    return BindiffReport {
        size_a: len_a,
        size_b: len_b,
        matching: matches,
        mismatches: mismatches,
        similarity_pct: pct
    };
}

pub fn format_diff_rows(a: String, b: String, start_offset: Int, limit: Int) -> String {
    let len_a: Int = chars_len(a);
    let len_b: Int = chars_len(b);
    let mut max_len: Int = len_a;
    if len_b > len_a {
        max_len = len_b;
    }

    let mut out: String = "";
    let mut count: Int = 0;
    let mut i: Int = start_offset;

    while i < max_len && (limit <= 0 || count < limit) {
        let has_a: Bool = i < len_a;
        let has_b: Bool = i < len_b;

        if has_a && has_b {
            let ba: Int = byte_at(a, i);
            let bb: Int = byte_at(b, i);
            if ba != bb {
                let off_str: String = offset_to_hex8(i);
                let row: String = off_str + ": 0x" + byte_to_hex(ba) + " '" + byte_to_ascii(ba) + "' -> 0x" + byte_to_hex(bb) + " '" + byte_to_ascii(bb) + "'";
                if chars_len(out) == 0 {
                    out = row;
                } else {
                    out = out + "\n" + row;
                }
                count = count + 1;
            }
        } else if has_a && !has_b {
            let ba: Int = byte_at(a, i);
            let off_str: String = offset_to_hex8(i);
            let row: String = off_str + ": 0x" + byte_to_hex(ba) + " '" + byte_to_ascii(ba) + "' -> <EOF> [DELETED]";
            if chars_len(out) == 0 {
                out = row;
            } else {
                out = out + "\n" + row;
            }
            count = count + 1;
        } else if !has_a && has_b {
            let bb: Int = byte_at(b, i);
            let off_str: String = offset_to_hex8(i);
            let row: String = off_str + ": <EOF> -> 0x" + byte_to_hex(bb) + " '" + byte_to_ascii(bb) + "' [INSERTED]";
            if chars_len(out) == 0 {
                out = row;
            } else {
                out = out + "\n" + row;
            }
            count = count + 1;
        }

        i = i + 1;
    }

    return out;
}

pub fn find_hunks_summary(a: String, b: String, max_hunks: Int) -> String {
    let len_a: Int = chars_len(a);
    let len_b: Int = chars_len(b);
    let mut max_len: Int = len_a;
    if len_b > len_a { max_len = len_b; }

    let mut out: String = "";
    let mut hunks_found: Int = 0;
    let mut in_hunk: Bool = false;
    let mut hunk_start: Int = 0;
    let mut hunk_len: Int = 0;
    let mut i: Int = 0;

    while i < max_len && (max_hunks <= 0 || hunks_found < max_hunks) {
        let is_diff: Bool = if i < len_a && i < len_b {
            byte_at(a, i) != byte_at(b, i)
        } else {
            true
        };

        if is_diff {
            if !in_hunk {
                in_hunk = true;
                hunk_start = i;
                hunk_len = 1;
            } else {
                hunk_len = hunk_len + 1;
            }
        } else {
            if in_hunk {
                in_hunk = false;
                let h_str: String = "Hunk @ 0x" + offset_to_hex8(hunk_start) + ": " + to_string(hunk_len) + " byte(s) mutated";
                if chars_len(out) == 0 {
                    out = h_str;
                } else {
                    out = out + "\n" + h_str;
                }
                hunks_found = hunks_found + 1;
            }
        }
        i = i + 1;
    }

    if in_hunk && (max_hunks <= 0 || hunks_found < max_hunks) {
        let h_str: String = "Hunk @ 0x" + offset_to_hex8(hunk_start) + ": " + to_string(hunk_len) + " byte(s) mutated";
        if chars_len(out) == 0 {
            out = h_str;
        } else {
            out = out + "\n" + h_str;
        }
    }

    return out;
}
